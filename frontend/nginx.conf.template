server {
    listen ${NGINX_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Dynamic upstream DNS (stale IP after Railway redeploys).
    # Railway private DNS: [fd12::10] — staff-confirmed on community forums;
    # not listed in official docs.railway.com Private Networking pages (checked 2026-09).
    # Local Docker Compose: 127.0.0.11 (embedded Docker DNS). Override via NGINX_RESOLVER.
    resolver ${NGINX_RESOLVER} valid=5s ipv6=on;
    resolver_timeout 5s;

    location / {
        # Use single-dollar nginx vars. Image envsubst only fills env-defined
        # names; doubled dollars stay as "$$uri" and break nginx startup.
        try_files $uri $uri/ /index.html;
    }

    location = /api/health {
        alias /var/cache/nginx/health.json;
        default_type application/json;
        add_header Cache-Control "no-store";
    }

    location /api/v1/cards/ {
        set $card_upstream ${CARD_SERVICE_URL};
        proxy_pass $card_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    location = /api/v1/cards {
        set $card_upstream ${CARD_SERVICE_URL};
        proxy_pass $card_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    location /api/v1/credits/ {
        set $credit_upstream ${CREDIT_SERVICE_URL};
        proxy_pass $credit_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    location = /api/v1/credits {
        set $credit_upstream ${CREDIT_SERVICE_URL};
        proxy_pass $credit_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    location /api/v1/collateral/ {
        set $collateral_upstream ${COLLATERAL_SERVICE_URL};
        proxy_pass $collateral_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 12m;
    }

    location = /api/v1/collateral {
        set $collateral_upstream ${COLLATERAL_SERVICE_URL};
        proxy_pass $collateral_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 12m;
    }
}
