# Shared credentials / hosts for local Docker Compose and bootRun.
# Copy to `.env` and set GEMINI_API_KEY. Never commit `.env`.

# PostgreSQL
POSTGRES_DB=bank_db
POSTGRES_USER=bank_user
POSTGRES_PASSWORD=bank_password

# JDBC used by card-service & credit-service (Docker network hostname: postgres)
DB_URL=jdbc:postgresql://postgres:5432/bank_db
DB_USER=bank_user
DB_PASSWORD=bank_password

# Redis (Docker service name: redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ (Docker service name: rabbitmq). For CloudAMQP live deploy see docs/DEPLOY.md
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=bank_guest
RABBITMQ_PASSWORD=bank_guest
RABBITMQ_VHOST=/
RABBITMQ_SSL=false

# Gemini Vision (ai-collateral-service)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_DELAY_MS=800
GEMINI_FALLBACK_VALUE_EUR=500.00
